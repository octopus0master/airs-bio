  "rewardCode": "// Reward Function for 2D Biped Locomotion\nfunction computeReward(state) {\n  // 1. Forward horizontal velocity & distance progress\n  const forwardVelReward = state.forwardVelocity * 6.0;\n  const distanceReward = state.totalDistance * 4.0;\n\n  // 2. Upright posture reward & Torso height clearance\n  const uprightBonus = state.uprightness > 0.5 ? state.uprightness * 3.0 : -4.0;\n  const heightBonus = state.torsoHeight > 0.65 ? 2.5 : -5.0;\n\n  // 3. Fall termination penalty\n  if (state.isFallen) return -10.0;\n\n  // 4. Energy cost to encourage smooth movements\n  const energyCost = state.energyPenalty * 0.015;\n\n  return forwardVelReward + distanceReward + uprightBonus + heightBonus - energyCost;\n}",
  "customBrainCode": "// Custom Neural Forward Control Logic (Biped Walk Pattern)\nfunction brainForward(inputs, weights, state, time) {\n  // inputs: [forwardVel, height, uprightness, groundContact, sinClock, cosClock, ...]\n  const stepFreq = 4.2;\n  const leftPhase = Math.sin(time * stepFreq);\n  const rightPhase = -Math.sin(time * stepFreq);\n  const strideCoupling = Math.cos(time * stepFreq);\n\n  return [\n    leftPhase,             // Hip Left\n    -leftPhase * 0.75,     // Knee Left\n    rightPhase,            // Hip Right\n    -rightPhase * 0.75,    // Knee Right\n    strideCoupling * 0.6   // Stride Cross Spring\n  ];\n}",
